# Brand name shown in the header, footer, metadata, and FAQ copy.
NEXT_PUBLIC_SITE_NAME=Filelite

# Public site origin used for canonical URLs, Open Graph, and the sitemap.
# Set this to the live https origin before a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Paste the Search Console content verification token (not the full meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Keep analytics off until a provider is registered in lib/analytics/analytics.ts.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Ads stay hidden until AdSense is approved and these are set.
# Client looks like ca-pub-1234567890123456. Slot ids are the numeric ids from AdSense.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_CONTENT=
NEXT_PUBLIC_AD_SLOT_BOTTOM=

# Optional. The contact form opens a mailto draft when this is set.
NEXT_PUBLIC_CONTACT_EMAIL=
